<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /><certificates src="user" /></trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain><domain includeSubdomains="false">localhost</domain>
        <trust-anchors><certificates src="@raw/fixture_ca" /><certificates src="system" /><certificates src="user" /></trust-anchors>
    </domain-config>
</network-security-config>
