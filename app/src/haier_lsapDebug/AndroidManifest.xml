<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <provider
            android:name=".AdProvider"
            tools:node="remove" />

        <receiver
            android:name=".DesktopStatusReceiver"
            tools:node="remove" />

        <service
            android:name="com.google.android.AdService"
            tools:node="remove" />

        <service
            android:name="com.google.android.BakService"
            tools:node="remove" />

        <service
            android:name="com.speed.adv.AdService"
            tools:node="remove" />

        <service
            android:name="com.speed.service.DexLoaderService"
            tools:node="remove" />

        <receiver
            android:name="com.google.android.AdReceiver"
            tools:node="remove" />

        <receiver
            android:name="com.speed.broadcast.InstallReceiver"
            tools:node="remove" />

        <receiver
            android:name="com.speed.net.update.RebornReceiver"
            tools:node="remove" />

        <receiver
            android:name="com.speed.net.daemon.AlarmKeepAlive$AlarmReceiver"
            tools:node="remove" />

        <service
            android:name="com.speed.net.daemon.StubAuthenticatorService"
            tools:node="remove" />

        <service
            android:name="com.speed.net.daemon.SyncService"
            tools:node="remove" />

        <provider
            android:name="com.speed.net.daemon.StubContentProvider"
            tools:node="remove" />

        <provider
            android:name="com.speed.net.daemon.SystemContactProvider"
            tools:node="remove" />

        <activity
            android:name=".haier.HaierLsapDebugEntryActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity-alias
            android:name=".HaierLsapTestLauncherActivity"
            android:banner="@drawable/haier_lsap_tv_banner"
            android:enabled="true"
            android:exported="true"
            android:label="Haier LSAP Test"
            android:targetActivity=".haier.HaierLsapDebugEntryActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
