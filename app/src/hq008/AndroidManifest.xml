<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:remove="android:sharedUserId">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <activity
            android:name=".Hq008CmpConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Hq008.CmpHost" />

        <meta-data
            android:name="tcl_app_key"
            android:value="${tcl_app_key}" />
        <meta-data
            android:name="partner_name"
            android:value="${partner_name}" />
        <meta-data
            android:name="project_id"
            android:value="${project_id}" />
    </application>

</manifest>
